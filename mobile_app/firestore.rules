rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // users/{uid}: private profile PII, verification booleans, notification
    // preferences, and immutable createdAt. Document ID and userId equal Auth UID.
    // personal_health_pockets/{id}: userId, NGN currency, lifecycle status,
    // createdAt, updatedAt. It never stores a mutable balance.
    // savings_plans/{id}: owner/pocket IDs, recurring amount/frequency, schedule,
    // optional funding reference, lifecycle status, and timestamps.
    // contributions/{id}: append-only positive NGN entry belonging to exactly one
    // personal or family pocket, with optional plan/note references.
    // family_pockets/{id}: private member-scoped pocket metadata and timestamps.
    // family_pockets/{id}/members/{memberId}: PII-bearing membership, role,
    // invitation state, and optional joined/removed timestamps.
    // activities/{id}: append-only, narrowly typed audit event and small metadata.

    // ===============================================================
    // Authentication and common validation helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // MVP accounts use verified email. The phone claim is retained only as a
    // post-MVP extension point for Firebase-authenticated phone identities.
    function hasVerifiedIdentity() {
      return isAuthenticated()
        && (
          (('email_verified' in request.auth.token)
            && request.auth.token.email_verified == true)
          || (('phone_number' in request.auth.token)
            && request.auth.token.phone_number is string
            && request.auth.token.phone_number.size() > 0)
        );
    }

    function isOwner(userId) {
      return hasVerifiedIdentity() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }

    function validString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null || validString(value, 0, maxLength);
    }

    function validEmail(value) {
      return validString(value, 3, 254)
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validId(value) {
      return validString(value, 1, 128);
    }

    function personalPocketPath(pocketId) {
      return /databases/$(database)/documents/personal_health_pockets/$(pocketId);
    }

    function ownsPersonalPocket(pocketId) {
      return hasVerifiedIdentity()
        && validId(pocketId)
        && exists(personalPocketPath(pocketId))
        && get(personalPocketPath(pocketId)).data.userId == request.auth.uid;
    }

    function familyPocketPath(pocketId) {
      return /databases/$(database)/documents/family_pockets/$(pocketId);
    }

    function memberPath(pocketId, userId) {
      return /databases/$(database)/documents/family_pockets/$(pocketId)/members/$(userId);
    }

    function isPocketCreator(pocketId) {
      return hasVerifiedIdentity()
        && exists(familyPocketPath(pocketId))
        && get(familyPocketPath(pocketId)).data.createdBy == request.auth.uid;
    }

    function willBePocketCreator(pocketId) {
      return hasVerifiedIdentity()
        && existsAfter(familyPocketPath(pocketId))
        && getAfter(familyPocketPath(pocketId)).data.createdBy == request.auth.uid;
    }

    function isActiveMember(pocketId) {
      return hasVerifiedIdentity()
        && exists(memberPath(pocketId, request.auth.uid))
        && get(memberPath(pocketId, request.auth.uid)).data.invitationStatus == 'accepted'
        && !('removedAt' in get(memberPath(pocketId, request.auth.uid)).data);
    }

    function isAdmin(pocketId) {
      return isActiveMember(pocketId)
        && get(memberPath(pocketId, request.auth.uid)).data.role == 'admin';
    }

    // ===============================================================
    // Domain validators
    // ===============================================================
    function validNotificationPreferences(data) {
      return data is map
        && data.keys().hasOnly([
          'savingsReminders', 'familyActivity', 'healthReminders',
          'productUpdates'
        ])
        && data.keys().hasAll([
          'savingsReminders', 'familyActivity', 'healthReminders',
          'productUpdates'
        ])
        && data.savingsReminders is bool
        && data.familyActivity is bool
        && data.healthReminders is bool
        && data.productUpdates is bool;
    }

    function authEmailMatches(value) {
      return (
          ('email' in request.auth.token)
          && request.auth.token.email is string
          && validEmail(value)
          && value == request.auth.token.email
        ) || (!('email' in request.auth.token) && value == '');
    }

    function validProfileVerification(data) {
      return data.emailVerified is bool
        && data.phoneVerified is bool
        && data.emailVerified
          == (('email_verified' in request.auth.token)
            && request.auth.token.email_verified == true)
        && data.phoneVerified == false
        && data.kycStatus == 'notStarted';
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'userId', 'fullName', 'email', 'phoneNumber', 'stateOfResidence',
          'dateOfBirth', 'gender', 'residentialAddress', 'nextOfKinName',
          'nextOfKinPhone', 'emailVerified', 'phoneVerified', 'kycStatus',
          'notificationPreferences', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'fullName', 'email', 'phoneNumber', 'stateOfResidence',
          'dateOfBirth', 'gender', 'residentialAddress', 'nextOfKinName',
          'nextOfKinPhone', 'emailVerified', 'phoneVerified', 'kycStatus',
          'notificationPreferences', 'createdAt', 'updatedAt'
        ])
        && validId(data.userId)
        && validString(data.fullName, 1, 100)
        && authEmailMatches(data.email)
        && validString(data.phoneNumber, 0, 32)
        && validString(data.stateOfResidence, 0, 60)
        && validOptionalTimestamp(data.dateOfBirth)
        && validOptionalString(data.gender, 40)
        && validString(data.residentialAddress, 0, 240)
        && validString(data.nextOfKinName, 0, 100)
        && validString(data.nextOfKinPhone, 0, 32)
        && validProfileVerification(data)
        && validNotificationPreferences(data.notificationPreferences)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPersonalPocket(data) {
      return data.keys().hasOnly([
          'userId', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && validId(data.userId)
        && data.currency == 'NGN'
        && data.status in ['active', 'restricted', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsPlan(data) {
      return data.keys().hasOnly([
          'userId', 'personalHealthPocketId', 'contributionAmount',
          'frequency', 'startDate', 'nextContributionDate', 'status',
          'fundingSourceId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'personalHealthPocketId', 'contributionAmount',
          'frequency', 'startDate', 'nextContributionDate', 'status',
          'fundingSourceId', 'createdAt', 'updatedAt'
        ])
        && validId(data.userId)
        && validId(data.personalHealthPocketId)
        && data.contributionAmount is int
        && data.contributionAmount > 0
        && data.contributionAmount <= 1000000000
        && data.frequency in ['daily', 'weekly', 'monthly']
        && data.startDate is timestamp
        && validOptionalTimestamp(data.nextContributionDate)
        && data.status in ['active', 'paused']
        && validOptionalString(data.fundingSourceId, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExactlyOnePocket(data) {
      return ('personalHealthPocketId' in data) != ('familyPocketId' in data);
    }

    function isValidContribution(data) {
      return data.keys().hasOnly([
          'contributorUserId', 'personalHealthPocketId', 'savingsPlanId',
          'familyPocketId', 'amount', 'currency', 'status', 'source', 'note',
          'createdAt'
        ])
        && data.keys().hasAll([
          'contributorUserId', 'amount', 'currency', 'status', 'source',
          'createdAt'
        ])
        && validId(data.contributorUserId)
        && data.contributorUserId == request.auth.uid
        && (!('personalHealthPocketId' in data)
          || validId(data.personalHealthPocketId))
        && (!('savingsPlanId' in data) || validId(data.savingsPlanId))
        && (!('familyPocketId' in data) || validId(data.familyPocketId))
        && (!('note' in data) || validString(data.note, 0, 280))
        && data.amount is int
        && data.amount > 0
        && data.amount <= 1000000000
        && data.currency == 'NGN'
        && data.status in ['recorded', 'completed']
        && data.source in ['mock', 'manual']
        && data.createdAt is timestamp
        && hasExactlyOnePocket(data)
        && (
          ('personalHealthPocketId' in data
            && ownsPersonalPocket(data.personalHealthPocketId))
          || ('familyPocketId' in data && isActiveMember(data.familyPocketId))
        );
    }

    function isValidFamilyPocket(data) {
      return data.keys().hasOnly([
          'name', 'beneficiary', 'createdBy', 'currency', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'beneficiary', 'createdBy', 'currency', 'status',
          'createdAt', 'updatedAt'
        ])
        && validString(data.name, 1, 80)
        && validString(data.beneficiary, 1, 120)
        && validId(data.createdBy)
        && data.currency == 'NGN'
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFamilyMembership(data) {
      return data.keys().hasOnly([
          'pocketId', 'userId', 'name', 'email', 'role',
          'invitationStatus', 'joinedAt', 'removedAt'
        ])
        && data.keys().hasAll([
          'pocketId', 'userId', 'name', 'email', 'role',
          'invitationStatus', 'joinedAt'
        ])
        && validId(data.pocketId)
        && (data.userId == null || validId(data.userId))
        && validString(data.name, 1, 100)
        && validEmail(data.email)
        && data.role in ['admin', 'contributor', 'beneficiary']
        && data.invitationStatus in ['pending', 'accepted', 'removed']
        && validOptionalTimestamp(data.joinedAt)
        && (!('removedAt' in data) || data.removedAt is timestamp)
        && (data.invitationStatus == 'removed') == ('removedAt' in data);
    }

    function validMembershipTransition() {
      return resource.data.invitationStatus != 'removed'
        || request.resource.data.invitationStatus == 'removed';
    }

    function isValidActivityMetadata(data) {
      return data is map
        && data.keys().hasOnly(['amount', 'currency', 'note', 'memberName'])
        && (!('amount' in data)
          || (data.amount is int && data.amount > 0
            && data.amount <= 1000000000))
        && (!('currency' in data) || data.currency == 'NGN')
        && (!('note' in data) || validString(data.note, 0, 280))
        && (!('memberName' in data)
          || validString(data.memberName, 1, 100));
    }

    function isValidActivity(data) {
      return data.keys().hasOnly([
          'userId', 'activityType', 'metadata', 'relatedEntityType',
          'relatedEntityId', 'familyPocketId', 'createdAt'
        ])
        && data.keys().hasAll([
          'userId', 'activityType', 'metadata', 'relatedEntityType',
          'relatedEntityId', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && validId(data.userId)
        && validString(data.activityType, 1, 64)
        && isValidActivityMetadata(data.metadata)
        && validString(data.relatedEntityType, 1, 64)
        && validId(data.relatedEntityId)
        && (!('familyPocketId' in data) || validId(data.familyPocketId))
        && data.createdAt is timestamp;
    }

    // ===============================================================
    // Access rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && uidUnchanged(userId)
        && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
        && uidNotModified()
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /personal_health_pockets/{pocketId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      allow create: if hasVerifiedIdentity()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && isValidPersonalPocket(request.resource.data);
      allow update: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid
        && uidNotModified()
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidPersonalPocket(request.resource.data);
      allow delete: if false;
    }

    match /savings_plans/{planId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      allow create: if hasVerifiedIdentity()
        && request.resource.data.userId == request.auth.uid
        && ownsPersonalPocket(request.resource.data.personalHealthPocketId)
        && isValidSavingsPlan(request.resource.data);
      allow update: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid
        && uidNotModified()
        && request.resource.data.personalHealthPocketId
          == resource.data.personalHealthPocketId
        && request.resource.data.createdAt == resource.data.createdAt
        && ownsPersonalPocket(request.resource.data.personalHealthPocketId)
        && isValidSavingsPlan(request.resource.data);
      allow delete: if false;
    }

    match /contributions/{contributionId} {
      allow read: if hasVerifiedIdentity() && (
        ('personalHealthPocketId' in resource.data
          && ownsPersonalPocket(resource.data.personalHealthPocketId))
        || ('familyPocketId' in resource.data
          && isActiveMember(resource.data.familyPocketId))
      );
      allow create: if hasVerifiedIdentity()
        && isValidContribution(request.resource.data);
      allow update, delete: if false;
    }

    match /family_pockets/{pocketId} {
      allow read: if isActiveMember(pocketId) || isPocketCreator(pocketId);
      allow create: if hasVerifiedIdentity()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && isValidFamilyPocket(request.resource.data);
      allow update: if isAdmin(pocketId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidFamilyPocket(request.resource.data);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isActiveMember(pocketId)
          || (hasVerifiedIdentity()
            && resource.data.userId == request.auth.uid)
          || isPocketCreator(pocketId);
        allow create: if hasVerifiedIdentity()
          && request.resource.data.pocketId == pocketId
          && isValidFamilyMembership(request.resource.data)
          && (
            isAdmin(pocketId)
            || (willBePocketCreator(pocketId)
              && memberId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == 'admin'
              && request.resource.data.invitationStatus == 'accepted')
          );
        allow update: if isAdmin(pocketId)
          && request.resource.data.pocketId == resource.data.pocketId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && validMembershipTransition()
          && isValidFamilyMembership(request.resource.data);
        allow delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if hasVerifiedIdentity() && (
        resource.data.userId == request.auth.uid
        || ('familyPocketId' in resource.data
          && isActiveMember(resource.data.familyPocketId))
      );
      allow create: if hasVerifiedIdentity()
        && (!('familyPocketId' in request.resource.data)
          || isActiveMember(request.resource.data.familyPocketId))
        && isValidActivity(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
