rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // users/{uid}: private profile PII, verification booleans, notification
    // preferences, an optional owner-scoped profileImagePath, and immutable
    // createdAt. Document ID and userId equal Auth UID.
    // personal_health_pockets/{id}: userId, NGN currency, lifecycle status,
    // createdAt, updatedAt. It never stores a mutable balance.
    // savings_plans/{id}: owner/pocket IDs, recurring amount/frequency, schedule,
    // optional funding reference, active/paused/cancelled lifecycle status, and
    // timestamps. Clients create active plans and may edit only active/paused
    // plans; cancelled is a terminal status written by the trusted backend.
    // scheduled_contributions/{id}: server-created execution record with a
    // userId owner field. Owners may read their records; all writes are trusted
    // backend-only.
    // contributions/dev_{uid}_{key} or dev_family_{uid}_{key}: immutable
    // DEV-only personal/family record. amountKobo is integer kobo;
    // moneyMovement is always false; createdAt is a server timestamp.
    // wallets/{uid}: server-owned NGN account cache. userId is immutable;
    // availableBalanceKobo is a non-negative integer derived from the ledger;
    // status is active/restricted/closed; version is an integer; createdAt and
    // updatedAt are trusted timestamps. Clients may only read their own wallet.
    // ledger_entries/{entryId}: immutable server-created posting with userId,
    // walletId, operationId, credit/debit direction, positive integer
    // amountKobo, NGN currency, completed status, source, optional bounded
    // provider/Family/reversal references, and a trusted createdAt timestamp.
    // financial_operations/{operationId}: server-owned transaction state with
    // the same ownership/amount/source fields, pending/completed/failed/
    // reversed/cancelled status, a request fingerprint, optional references,
    // and trusted timestamps. Flutter has read-only owner access.
    // funding_transactions/{transactionId}: server-owned funding lifecycle
    // record containing userId, positive integer amountKobo, NGN currency,
    // normalized status, nullable provider/ledger references,
    // receipt-ready metadata, and trusted timestamps. Clients have owner-only
    // read access and cannot mutate funding history.
    // healthcare_payments/{paymentId}: server-owned owner history projection.
    // Required fields: schemaVersion (integer), userId, flowType (partner or
    // non_partner), providerId/name/category/city/state, positive integer
    // amountKobo, NGN currency, status (created/pending/completed/failed/
    // cancelled/reversed), verificationStatus (not_required/pending/verified/
    // rejected/unavailable), paymentProvider, transactionReference,
    // description, channel (mock/provider), requestFingerprint, createdAt, and
    // updatedAt. Nullable fields: paymentAttemptId, verificationSource,
    // verificationReference, failureCode, providerReference, ledgerOperationId,
    // ledgerEntryId, receiptNumber, completedAt, and beneficiary. Beneficiary is
    // a non-partner safe-display map containing only accountNumberLast4,
    // bankCode, bankName, accountName, and beneficiaryReference; raw account
    // numbers are never stored. Clients have verified-owner read-only access.
    // receipts/{receiptNumber}: immutable completed-only receipt projection.
    // Document ID equals receiptNumber (HPF-/HPC- plus 12 hexadecimal chars).
    // Required fields: schemaVersion, receiptNumber, healthPocketReferenceId,
    // userId, transactionId, transactionType (wallet_funding or
    // healthcare_payment), transactionReference, status (completed), positive
    // integer amountKobo, NGN currency, bounded provider/recipient/paymentMethod
    // snapshot maps, description, ledgerOperationId, issuedAt, createdAt, and
    // sourceFingerprint. flowType is optional; ledgerEntryId is nullable. The
    // trusted backend snapshots display data so later provider changes do not
    // rewrite history. Verified owners may read; all writes are backend-only.
    // notification_events/{eventId}: server-owned owner-scoped notification
    // record containing schemaVersion, userId, type/category, bounded
    // title/body, readState (unread/read), nullable readAt, delivery state,
    // nullable related entity/Family Pocket references, and trusted createdAt/
    // updatedAt timestamps. Verified owners may read; read-state and delivery
    // mutations are trusted-backend-only.
    // notification_devices/{deviceId}: private backend-only FCM registration
    // containing schemaVersion, userId, raw push token, platform, lifecycle
    // status, delivery diagnostics, and trusted timestamps. No client reads or
    // writes are permitted because possession of a token enables push delivery.
    // email_outbox/{messageId}: backend-only transactional delivery record with
    // schemaVersion, recipientEmail PII, eventType/classification, bounded
    // template variables, requestFingerprint, delivery status/attempt fields,
    // provider response metadata/errors, and trusted timestamps. It is never
    // exposed through the client Firestore SDK.
    // email_rate_limits/{bucketId}: backend-only abuse-control bucket containing
    // schemaVersion, recipientHash, email classification, count, windowStartedAt,
    // windowEndsAt, and updatedAt. Clients cannot inspect or reset rate state.
    // email_verification_challenges/{challengeId}: reserved and disabled for
    // the Google-only MVP. Any future backend implementation must store hashes
    // only (never plaintext codes) plus attempt/state/expiry metadata, and must
    // remain completely inaccessible through the client Firestore SDK.
    // family_pockets/{id}: private active-member-scoped pocket with immutable
    // ownerId (or legacy createdBy), bounded name/optional description and
    // imagePath, contribution frequency/default amount, NGN currency, status,
    // server-maintained balanceKobo/version, and trusted timestamps.
    // family_pockets/{id}/members/{uid}: server-owned membership display data,
    // explicit owner/admin/member role, contribution/beneficiary permissions,
    // lifecycle state, and trusted joined/removed timestamps.
    // family_pockets/{id}/invites/{inviteId}: admin/invitee-scoped invitation
    // PII, assigned capabilities, seven-day expiry, and response state.
    // family_pockets/{id}/beneficiary_slots/{1|2}: coordination record proving
    // that no more than two pending or accepted beneficiaries are reserved.
    // family_contribution_attempts/{id}: server-owned contribution workflow;
    // readable only by its contributor or an active pocket owner/admin.
    // family_ledger_entries/{id}: immutable server-owned Family Pocket posting;
    // readable only by active members of the referenced familyPocketId.
    // healthcare_providers/{providerId}: server/admin-owned directory containing
    // no patient/user PII. All fields are required: schemaVersion (integer),
    // name and normalizedName (strings, max 160), category (hospital/clinic/
    // pharmacy/diagnostics/other), partnerStatus (partner/non_partner), address
    // (string, max 500), state and city (strings, max 100), coordinates map with
    // numeric latitude/longitude, locationCell (string list, max 20), contact map
    // with nullable bounded phone/email/website, openingInformation (nullable
    // string, max 1,000), logoUrl (nullable URL, max 2,048), imageUrls (URL list,
    // max 10), services (string list, max 40), searchPrefixes (normalized string
    // list, max 50), active (boolean), createdAt/updatedAt (timestamps), and
    // deactivatedAt (nullable timestamp). Verified Google clients may read only
    // active records; all create/update/delete operations are backend-only.
    // coverage_items/{coverageItemId}: server/admin-owned, non-PII indicative
    // care-cost catalog. Required fields: schemaVersion (1), name and
    // normalizedName, category (consultation/diagnostics/pharmacy/dental/
    // vision/maternal_care/other), positive integer indicativePriceKobo, NGN
    // currency, priceType (indicative_estimate), sourceName, nullable
    // sourceReference/providerId, locationContext map with nullable state/city,
    // fixed disclaimer, active, createdAt/updatedAt/lastUpdatedAt, and nullable
    // deactivatedAt. Verified Google clients may read active records only; all
    // catalog writes are trusted-admin-only.
    // activities/{id}: append-only, narrowly typed audit event and small metadata.

    // ===============================================================
    // Authentication and common validation helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Google is the only MVP account-entry provider. Provider membership and
    // email verification must both come from the trusted Firebase Auth token.
    function hasVerifiedIdentity() {
      return isAuthenticated()
        && ('firebase' in request.auth.token)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function hasVerifiedEmailIdentity() {
      return hasVerifiedIdentity()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && validEmail(request.auth.token.email)
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return hasVerifiedIdentity() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }

    function validString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null || validString(value, 0, maxLength);
    }

    function validEmail(value) {
      return validString(value, 3, 254)
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validId(value) {
      return validString(value, 1, 256)
        && value.matches('^[A-Za-z0-9_-]{1,256}$');
    }

    function validUserId(value) {
      return validString(value, 1, 128)
        && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function isCanonicalPersonalPocketId(pocketId, userId) {
      return pocketId == 'personal-' + userId;
    }

    function isCanonicalSavingsPlanId(planId, userId) {
      return planId == 'personal-plan-' + userId;
    }

    function personalPocketPath(pocketId) {
      return /databases/$(database)/documents/personal_health_pockets/$(pocketId);
    }

    function ownsPersonalPocket(pocketId) {
      return hasVerifiedIdentity()
        && validId(pocketId)
        && exists(personalPocketPath(pocketId))
        && get(personalPocketPath(pocketId)).data.userId == request.auth.uid;
    }

    function savingsPlanPath(planId) {
      return /databases/$(database)/documents/savings_plans/$(planId);
    }

    function ownsSavingsPlanForPocket(planId, pocketId) {
      return hasVerifiedIdentity()
        && validId(planId)
        && exists(savingsPlanPath(planId))
        && get(savingsPlanPath(planId)).data.userId == request.auth.uid
        && get(savingsPlanPath(planId)).data.personalHealthPocketId == pocketId;
    }

    function isCurrentUserDevContributionId(contributionId) {
      return hasVerifiedIdentity()
        && validString(contributionId, 24, 256)
        && contributionId.matches(
          '^dev_' + request.auth.uid + '_[A-Za-z0-9_-]{16,80}$'
        );
    }

    function contributionPath(contributionId) {
      return /databases/$(database)/documents/contributions/$(contributionId);
    }

    function canGetCurrentUserDevContribution(contributionId) {
      return isCurrentUserDevContributionId(contributionId)
        && (
          !exists(contributionPath(contributionId))
          || (
            resource.data.contributorUserId == request.auth.uid
            && ownsPersonalPocket(resource.data.personalHealthPocketId)
          )
        );
    }

    function familyPocketPath(pocketId) {
      return /databases/$(database)/documents/family_pockets/$(pocketId);
    }

    function memberPath(pocketId, userId) {
      return /databases/$(database)/documents/family_pockets/$(pocketId)/members/$(userId);
    }

    function isActiveMember(pocketId) {
      return hasVerifiedIdentity()
        && exists(familyPocketPath(pocketId))
        && exists(memberPath(pocketId, request.auth.uid))
        && (
          get(memberPath(pocketId, request.auth.uid)).data.get('status', '') == 'active'
          ||
          get(memberPath(pocketId, request.auth.uid)).data.get('status', '') == 'accepted'
          || get(memberPath(pocketId, request.auth.uid)).data.get('invitationStatus', '') == 'accepted'
        )
        && get(memberPath(pocketId, request.auth.uid)).data
          .get('removedAt', null) == null
        && get(memberPath(pocketId, request.auth.uid)).data
          .get('leftAt', null) == null;
    }

    function isAdmin(pocketId) {
      return isActiveMember(pocketId)
        && get(memberPath(pocketId, request.auth.uid)).data.role
          in ['owner', 'admin'];
    }

    function canContributeToFamilyPocket(pocketId) {
      return isActiveMember(pocketId)
        && (
          get(memberPath(pocketId, request.auth.uid)).data.get('canContribute', false) == true
          || get(memberPath(pocketId, request.auth.uid)).data
            .get('permissions', {}).get('canContribute', false) == true
          || get(memberPath(pocketId, request.auth.uid)).data.role
            in ['owner', 'admin', 'contributor']
        );
    }

    function isCurrentUserFamilyDevContributionId(contributionId) {
      return hasVerifiedIdentity()
        && validString(contributionId, 31, 263)
        && contributionId.matches(
          '^dev_family_' + request.auth.uid + '_[A-Za-z0-9_-]{16,80}$'
        );
    }

    function canGetCurrentUserFamilyDevContribution(contributionId) {
      return isCurrentUserFamilyDevContributionId(contributionId)
        && (
          !exists(contributionPath(contributionId))
          || (
            resource.data.contributorUserId == request.auth.uid
            && canContributeToFamilyPocket(resource.data.familyPocketId)
          )
        );
    }

    // ===============================================================
    // Domain validators
    // ===============================================================
    function validNotificationPreferences(data) {
      return data is map
        && data.keys().hasOnly([
          'savingsReminders', 'familyActivity', 'healthReminders',
          'productUpdates'
        ])
        && data.keys().hasAll([
          'savingsReminders', 'familyActivity', 'healthReminders',
          'productUpdates'
        ])
        && data.savingsReminders is bool
        && data.familyActivity is bool
        && data.healthReminders is bool
        && data.productUpdates is bool;
    }

    function authEmailMatches(value) {
      return (
          ('email' in request.auth.token)
          && request.auth.token.email is string
          && validEmail(value)
          && value == request.auth.token.email
        ) || (!('email' in request.auth.token) && value == '');
    }

    function validProfileVerification(data) {
      return data.emailVerified is bool
        && data.phoneVerified is bool
        && data.emailVerified
          == (('email_verified' in request.auth.token)
            && request.auth.token.email_verified == true)
        && data.phoneVerified == false
        && data.kycStatus == 'notStarted';
    }

    function validOnboardingStatus(data) {
      return data.onboardingStatus in ['incomplete', 'complete']
        && (data.onboardingStatus == 'incomplete'
          || (data.dateOfBirth is timestamp
            && validString(data.gender, 1, 40)
            && validString(data.stateOfResidence, 1, 60)
            && validString(data.residentialAddress, 1, 240)));
    }

    function validProfileImagePath(data) {
      return !('profileImagePath' in data)
        || data.profileImagePath == null
        || (validString(data.profileImagePath, 52, 320)
          && data.profileImagePath.matches(
            '^users/' + data.userId
              + '/profile/[A-Fa-f0-9]{32}\\.(jpg|png|webp)$'
          ));
    }

    function onboardingStatusNotReverted() {
      return resource.data.get('onboardingStatus', 'complete') != 'complete'
        || request.resource.data.onboardingStatus == 'complete';
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'userId', 'fullName', 'email', 'phoneNumber', 'stateOfResidence',
          'dateOfBirth', 'gender', 'residentialAddress', 'nextOfKinName',
          'nextOfKinPhone', 'emailVerified', 'phoneVerified', 'kycStatus',
          'notificationPreferences', 'onboardingStatus', 'profileImagePath',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'fullName', 'email', 'phoneNumber', 'stateOfResidence',
          'dateOfBirth', 'gender', 'residentialAddress', 'nextOfKinName',
          'nextOfKinPhone', 'emailVerified', 'phoneVerified', 'kycStatus',
          'notificationPreferences', 'onboardingStatus', 'createdAt', 'updatedAt'
        ])
        && validUserId(data.userId)
        && validString(data.fullName, 1, 100)
        && authEmailMatches(data.email)
        && validString(data.phoneNumber, 0, 32)
        && validString(data.stateOfResidence, 0, 60)
        && validOptionalTimestamp(data.dateOfBirth)
        && validOptionalString(data.gender, 40)
        && validString(data.residentialAddress, 0, 240)
        && validString(data.nextOfKinName, 0, 100)
        && validString(data.nextOfKinPhone, 0, 32)
        && validProfileVerification(data)
        && validOnboardingStatus(data)
        && validProfileImagePath(data)
        && validNotificationPreferences(data.notificationPreferences)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPersonalPocket(data) {
      return data.keys().hasOnly([
          'userId', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && validUserId(data.userId)
        && data.currency == 'NGN'
        && data.status in ['active', 'restricted', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsPlan(data) {
      return data.keys().hasOnly([
          'userId', 'personalHealthPocketId', 'contributionAmountKobo',
          'frequency', 'startDate', 'nextContributionDate', 'status',
          'fundingSourceId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'personalHealthPocketId', 'contributionAmountKobo',
          'frequency', 'startDate', 'nextContributionDate', 'status',
          'fundingSourceId', 'createdAt', 'updatedAt'
        ])
        && validUserId(data.userId)
        && validId(data.personalHealthPocketId)
        && data.contributionAmountKobo is int
        && data.contributionAmountKobo > 0
        && data.contributionAmountKobo <= 100000000000
        && data.frequency in ['daily', 'weekly', 'monthly']
        && data.startDate is timestamp
        && validOptionalTimestamp(data.nextContributionDate)
        && data.status in ['active', 'paused', 'cancelled']
        && validOptionalString(data.fundingSourceId, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isClientEditableSavingsPlanTransition() {
      return resource.data.status in ['active', 'paused']
        && request.resource.data.status in ['active', 'paused'];
    }

    function isValidDevelopmentContribution(contributionId, data) {
      return data.keys().hasOnly([
          'contributorUserId', 'personalHealthPocketId', 'savingsPlanId',
          'amountKobo', 'currency', 'status', 'origin', 'moneyMovement',
          'idempotencyKey', 'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'contributorUserId', 'personalHealthPocketId', 'savingsPlanId',
          'amountKobo', 'currency', 'status', 'origin', 'moneyMovement',
          'idempotencyKey', 'createdAt'
        ])
        && validUserId(data.contributorUserId)
        && data.contributorUserId == request.auth.uid
        && validId(data.personalHealthPocketId)
        && validId(data.savingsPlanId)
        && validString(data.idempotencyKey, 16, 80)
        && data.idempotencyKey.matches('^[A-Za-z0-9_-]{16,80}$')
        && contributionId
          == 'dev_' + request.auth.uid + '_' + data.idempotencyKey
        && (!('note' in data) || validString(data.note, 0, 280))
        && data.amountKobo is int
        && data.amountKobo > 0
        && data.amountKobo <= 100000000000
        && data.currency == 'NGN'
        && data.status == 'recorded'
        && data.origin == 'dev_simulation'
        && data.moneyMovement == false
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && ownsPersonalPocket(data.personalHealthPocketId)
        && ownsSavingsPlanForPocket(
          data.savingsPlanId,
          data.personalHealthPocketId
        );
    }

    function isValidFamilyDevelopmentContribution(contributionId, data) {
      return data.keys().hasOnly([
          'contributorUserId', 'familyPocketId', 'contributorName',
          'amountKobo', 'currency', 'status', 'origin', 'moneyMovement',
          'idempotencyKey', 'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'contributorUserId', 'familyPocketId', 'contributorName',
          'amountKobo', 'currency', 'status', 'origin', 'moneyMovement',
          'idempotencyKey', 'createdAt'
        ])
        && data.contributorUserId == request.auth.uid
        && validUserId(data.contributorUserId)
        && validId(data.familyPocketId)
        && validString(data.contributorName, 1, 100)
        && data.contributorName
          == get(memberPath(data.familyPocketId, request.auth.uid)).data.name
        && validString(data.idempotencyKey, 16, 80)
        && data.idempotencyKey.matches('^[A-Za-z0-9_-]{16,80}$')
        && contributionId
          == 'dev_family_' + request.auth.uid + '_' + data.idempotencyKey
        && (!('note' in data) || validString(data.note, 0, 280))
        && data.amountKobo is int
        && data.amountKobo > 0
        && data.amountKobo <= 100000000000
        && data.currency == 'NGN'
        && data.status == 'recorded'
        && data.origin == 'dev_simulation'
        && data.moneyMovement == false
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && canContributeToFamilyPocket(data.familyPocketId);
    }

    // ===============================================================
    // Access rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validUserId(userId)
        && uidUnchanged(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.onboardingStatus == 'incomplete'
        && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
        && validUserId(userId)
        && uidNotModified()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && onboardingStatusNotReverted()
        && isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /personal_health_pockets/{pocketId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      allow create: if hasVerifiedIdentity()
        && request.resource.data.userId == request.auth.uid
        && isCanonicalPersonalPocketId(pocketId, request.auth.uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidPersonalPocket(request.resource.data);
      allow update: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid
        && isCanonicalPersonalPocketId(pocketId, request.auth.uid)
        && uidNotModified()
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && isValidPersonalPocket(request.resource.data);
      allow delete: if false;
    }

    match /savings_plans/{planId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      allow create: if hasVerifiedIdentity()
        && request.resource.data.userId == request.auth.uid
        && isCanonicalSavingsPlanId(planId, request.auth.uid)
        && ownsPersonalPocket(request.resource.data.personalHealthPocketId)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidSavingsPlan(request.resource.data);
      allow update: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid
        && isCanonicalSavingsPlanId(planId, request.auth.uid)
        && uidNotModified()
        && request.resource.data.personalHealthPocketId
          == resource.data.personalHealthPocketId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && ownsPersonalPocket(request.resource.data.personalHealthPocketId)
        && isClientEditableSavingsPlanTransition()
        && isValidSavingsPlan(request.resource.data);
      allow delete: if false;
    }

    match /scheduled_contributions/{scheduledContributionId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Scheduling, execution state, retries, and cancellation are controlled
      // only by the trusted backend. A client must not forge a due execution.
      allow create, update, delete: if false;
    }

    match /contributions/{contributionId} {
      // The deterministic owner prefix permits a transaction to read a missing
      // idempotent path. Existing documents remain private to their owner.
      allow get: if canGetCurrentUserDevContribution(contributionId)
        || canGetCurrentUserFamilyDevContribution(contributionId);
      allow list: if hasVerifiedIdentity()
        && (
          (resource.data.contributorUserId == request.auth.uid
            && ('personalHealthPocketId' in resource.data)
            && ownsPersonalPocket(resource.data.personalHealthPocketId))
          || (('familyPocketId' in resource.data)
            && isActiveMember(resource.data.familyPocketId))
        );
      allow create: if hasVerifiedIdentity()
        && (
          isValidDevelopmentContribution(
            contributionId,
            request.resource.data
          )
          || isValidFamilyDevelopmentContribution(
            contributionId,
            request.resource.data
          )
        );
      allow update, delete: if false;
    }

    match /wallets/{walletId} {
      allow read: if hasVerifiedIdentity()
        && walletId == request.auth.uid
        && resource.data.userId == request.auth.uid;
      // Wallet creation and every cached-balance mutation bypass rules only
      // through the Admin SDK in the trusted backend.
      allow create, update, delete: if false;
    }

    match /ledger_entries/{entryId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Completed postings are immutable and server-owned. A reversal creates
      // a compensating entry instead of changing or deleting history.
      allow create, update, delete: if false;
    }

    match /financial_operations/{operationId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Only verified backend workflows may progress operation state.
      allow create, update, delete: if false;
    }

    match /funding_transactions/{transactionId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Lifecycle transitions, provider verification, receipt metadata, and
      // wallet-credit linkage are written only by the trusted backend.
      allow create, update, delete: if false;
    }

    match /healthcare_payments/{paymentId} {
      // Owner-scoped list queries must constrain userId to request.auth.uid;
      // ordering by createdAt and pagination limits do not widen this predicate.
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Initialization, verification, debit finalization, failure transitions,
      // ledger linkage, and receipt creation are trusted-backend-only.
      allow create, update, delete: if false;
    }

    match /receipts/{receiptId} {
      // Owner-scoped list queries must constrain userId to request.auth.uid;
      // ordering by issuedAt (or createdAt) and limits preserve this predicate.
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Receipt identity, completed status, amounts, provider/recipient
      // snapshots, ledger references, and issue timestamps are immutable and
      // generated only from authoritative completed transactions.
      allow create, update, delete: if false;
    }

    match /notification_events/{eventId} {
      allow read: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid;
      // Notification generation and delivery state are authoritative backend
      // records. Clients cannot manufacture, acknowledge, or delete events.
      allow create, update, delete: if false;
    }

    match /notification_devices/{deviceId} {
      // Push tokens and delivery diagnostics never cross the client Firestore
      // boundary. Registration, refresh, revocation, and dispatch use the
      // authenticated trusted backend instead.
      allow read, create, update, delete: if false;
    }

    match /email_outbox/{messageId} {
      // Recipient PII, template variables, delivery errors, and provider
      // metadata are accessible only to trusted Admin SDK email workers.
      allow read, create, update, delete: if false;
    }

    match /email_rate_limits/{bucketId} {
      // Rate-limit inspection or mutation would disclose security state and
      // enable quota resets, so even authenticated/admin-claim clients fail.
      allow read, create, update, delete: if false;
    }

    match /email_verification_challenges/{challengeId} {
      // Verification hashes, attempts, expiry, and consumption are handled by
      // the trusted backend; clients interact only through authenticated APIs.
      allow read, create, update, delete: if false;
    }

    match /healthcare_providers/{providerId} {
      // Queries must include active == true. Optional category, partnerStatus,
      // state/city, searchPrefixes, locationCell, ordering, and limit clauses do
      // not widen this predicate, so the same rule supports filtered discovery.
      allow read: if hasVerifiedIdentity()
        && resource.data.active == true;
      // Directory seeding, correction, activation, and deactivation are trusted
      // Admin SDK operations. Ordinary clients cannot publish or alter listings.
      allow create, update, delete: if false;
    }

    match /coverage_items/{coverageItemId} {
      // List queries must constrain active == true. Ordering by indicative
      // price and applying a bounded limit do not widen the readable result.
      allow read: if hasVerifiedIdentity()
        && resource.data.active == true;
      // Prices, sources, disclaimers, timestamps, and activation state are
      // maintained only through trusted catalog administration.
      allow create, update, delete: if false;
    }

    match /family_pockets/{pocketId} {
      allow read: if isActiveMember(pocketId);
      // Creation, metadata edits, balance/version changes, ownership transfer,
      // closure, and deletion are trusted-service operations only.
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if isActiveMember(pocketId);
        // Role/permission assignment, removal, leaving, and ownership transfer
        // must pass trusted backend invariants. The owner cannot remove itself
        // by editing or deleting its membership from a client.
        allow create, update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isAdmin(pocketId)
          || (hasVerifiedEmailIdentity()
            && resource.data.email == request.auth.token.email);
        // Invite creation, response, cancellation, expiry, and membership
        // materialization are atomic trusted-service workflows.
        allow create, update, delete: if false;
      }

      match /beneficiary_slots/{slotId} {
        allow read: if isActiveMember(pocketId);
        allow create, update, delete: if false;
      }
    }

    match /family_contribution_attempts/{attemptId} {
      allow read: if hasVerifiedIdentity()
        && validId(resource.data.pocketId)
        && isActiveMember(resource.data.pocketId)
        && (
          resource.data.contributorUserId == request.auth.uid
          || isAdmin(resource.data.pocketId)
        );
      allow create, update, delete: if false;
    }

    match /family_ledger_entries/{entryId} {
      allow read: if hasVerifiedIdentity()
        && validId(resource.data.familyPocketId)
        && isActiveMember(resource.data.familyPocketId);
      // Completed postings are immutable and all writes are trusted-backend
      // operations. Reversals create compensating entries.
      allow create, update, delete: if false;
    }

    // Collection-group discovery is restricted to the authenticated user's
    // own active/accepted membership records. Pocket-scoped member reads
    // continue to use the stricter rules above.
    match /{path=**}/members/{memberId} {
      allow list: if hasVerifiedIdentity()
        && resource.data.userId == request.auth.uid
        && (resource.data.get('status', '') in ['active', 'accepted']
          || resource.data.get('invitationStatus', '') == 'accepted')
        && resource.data.get('removedAt', null) == null
        && resource.data.get('leftAt', null) == null;
    }

    match /{path=**}/invites/{inviteId} {
      allow list: if hasVerifiedEmailIdentity()
        && resource.data.email == request.auth.token.email
        && resource.data.status == 'pending';
    }

    match /activities/{activityId} {
      allow read: if hasVerifiedIdentity() && (
        resource.data.userId == request.auth.uid
        || ('familyPocketId' in resource.data
          && isActiveMember(resource.data.familyPocketId))
      );
      // Audit events must come from a future trusted service, never a client
      // that can manufacture its own history.
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
