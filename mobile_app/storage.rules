rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasVerifiedGoogleIdentity() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(userId) {
      return hasVerifiedGoogleIdentity() && request.auth.uid == userId;
    }

    function isValidProfilePhoto(fileName) {
      return fileName.matches('^[A-Fa-f0-9]{32}\\.(jpg|png|webp)$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidProfilePhoto(fileName);
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
